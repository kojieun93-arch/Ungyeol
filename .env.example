# ──────────────────────────────────────────────────────────
# 운결 환경 변수 예시 — 이 파일만 저장소에 들어가요. 실제 값은 .env.local (gitignore) 또는 Vercel 환경 변수에
# 지금은 아무 값도 없어도 돼요 → 화면은 샘플 사주, /api/manse 는 503 not-configured
#
# 모두 서버 전용이에요. NEXT_PUBLIC_ 을 붙이지 마세요 (붙이면 브라우저 번들에 들어가요)
# 키 값은 코드 · 채팅 · 문서 · 스크린샷에 적지 마세요
# ──────────────────────────────────────────────────────────

# 실제 만세력 계산을 켤 때만 hrum
# MANSE_PROVIDER=hrum

# HRUM 콘솔(console.hrum.ai)에서 확인한 값. 주소는 공식 문서에서 확인 후 입력 (https 만)
# HRUM_API_BASE_URL=
# HRUM_API_KEY=

# 응답 → 화면 데이터 매핑을 공식 문서로 확인한 뒤에만 true (그 전에는 결과를 '계산 완료'로 쓰지 않음)
# HRUM_MAPPING_VERIFIED=false

# 선택: 요청 타임아웃(ms, 1000~20000, 기본 8000) · IP당 분당 요청 수(1~120, 기본 10)
# HRUM_TIMEOUT_MS=8000
# MANSE_RATE_LIMIT_PER_MINUTE=10
