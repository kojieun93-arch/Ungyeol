# ──────────────────────────────────────────────────────────
# 운결 환경 변수 예시 — 이 파일만 저장소에 들어가요. 실제 값은 Vercel 환경 변수(또는 .env.local, gitignore)에
# 모두 서버 전용이에요. NEXT_PUBLIC_ 을 붙이지 마세요 (붙이면 브라우저 번들에 들어가요)
# 키 · 토큰 값은 코드 · 채팅 · 문서 · 스크린샷에 적지 마세요
# 아무것도 없으면: 화면은 샘플 사주, /api/manse 는 503 not-configured
# ──────────────────────────────────────────────────────────

# 실제 만세력 계산을 켤 때만 hrum
# MANSE_PROVIDER=hrum

# HRUM 콘솔(console.hrum.ai → API 키)에서 발급. 발급 직후 한 번만 보여요
# HRUM_API_KEY=

# 검증 기간(매핑 확인 전)의 확인용 토큰 — 직접 만든 24자 이상 임의 문자열
# 이 토큰이 있는 요청만 실제 계산 (공개 주소로 요금이 새지 않게). scripts/manse-check.mjs 에서 같은 값 사용
# MANSE_CHECK_TOKEN=

# 선택: 비우면 공식 기본 주소 https://api.hrum.ai (경로 /api/v1/partners/v1/manseryeok 는 코드가 붙임)
# HRUM_API_BASE_URL=

# 실제 호출 결과를 기준 만세력과 대조해 확인한 뒤에만 true. 그 전에는 설정하지 마세요
# HRUM_MAPPING_VERIFIED=

# 선택: 요청 타임아웃(ms, 1000~20000, 기본 8000) · IP당 분당 요청 수(1~120, 기본 10)
# HRUM_TIMEOUT_MS=8000
# MANSE_RATE_LIMIT_PER_MINUTE=10
