# ──────────────────────────────────────────────────────────
# 운결 환경 변수 예시 — 이 파일만 저장소에 들어가요. 실제 값은 Vercel 환경 변수(또는 .env.local, gitignore)에
# 모두 서버 전용이에요. NEXT_PUBLIC_ 을 붙이지 마세요 (붙이면 브라우저 번들에 들어가요)
# 키 · 토큰 값은 코드 · 채팅 · 문서 · 스크린샷에 적지 마세요
# 아무것도 없으면: 화면은 샘플 사주, /api/manse 는 503 not-configured
# ──────────────────────────────────────────────────────────

# 실제 만세력 계산을 켤 때만 hrum
# MANSE_PROVIDER=hrum

# HRUM 콘솔(console.hrum.ai → API 키)에서 발급. 발급 직후 한 번만 보여요
# HRUM_API_KEY=

# 검증 기간(매핑 확인 전)의 확인용 토큰 — 직접 만든 24자 이상 임의 문자열
# 이 토큰이 있는 요청만 실제 계산 (공개 주소로 요금이 새지 않게). scripts/manse-check.mjs 에서 같은 값 사용
# MANSE_CHECK_TOKEN=

# 선택: 비우면 공식 기본 주소 https://api.hrum.ai (경로 /api/v1/partners/v1/manseryeok 는 코드가 붙임)
# HRUM_API_BASE_URL=

# 실제 호출 결과를 기준 만세력과 대조해 확인한 뒤에만 true. 그 전에는 설정하지 마세요
# HRUM_MAPPING_VERIFIED=

# 사용자 화면에 실제 계산을 공개할 때만 true. 아래 공유 저장소 · 서명 비밀값까지 모두 있어야 효과가 있어요
# 순서: Upstash → MANSE_SIGNING_SECRET → (Turnstile) → HRUM_MAPPING_VERIFIED → 마지막에 이 값 (docs/MANSE.md '안전한 전환 순서')
# MANSE_PUBLIC_ENABLED=

# ── 공유 사용량 저장소 (공개 모드 필수) — Vercel Storage 'Upstash for Redis' 연결 시 KV_REST_API_* 가 자동 등록
# 주소는 https://*.upstash.io 만 허용. 둘 중 한 쌍만 있으면 돼요
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── 공개 요청 서명 쿠키 비밀값 (공개 모드 필수, 32자 이상 임의 문자열)
# MANSE_SIGNING_SECRET=

# ── 봇 확인 (선택, 권장) — Cloudflare Turnstile. 둘 다 있으면 켜져요 (사이트 키는 공개값, 비밀 키는 서버 전용)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── 사용량 한도 (선택) — 모두 공유 저장소에서 인스턴스 전체로 셈
# 하루 전체 HRUM 호출 상한(토큰 요청 포함, 한국 자정 초기화). HRUM 콘솔 하루 한도(20)보다 작게
# MANSE_DAILY_BUDGET=18
# 그중 운영자 확인용으로 남겨 둘 몫 (공개 요청은 DAILY_BUDGET − 이 값까지)
# MANSE_OPERATOR_RESERVE=3
# HRUM 초당 호출 수 (콘솔 초당 제한과 같게) · 동시에 진행 중인 HRUM 호출 수
# MANSE_UPSTREAM_PER_SECOND=1
# MANSE_MAX_CONCURRENT=2
# IP당 하루 공개 계산 수
# MANSE_IP_DAILY_LIMIT=5

# 선택: 요청 타임아웃(ms, 1000~20000, 기본 8000) · IP당 분당 요청 수(1~120, 기본 10, 공개 요청은 최대 3)
# HRUM_TIMEOUT_MS=8000
# MANSE_RATE_LIMIT_PER_MINUTE=10
